#VRML V2.0 utf8

DEF BODY Appearance { material Material { diffuseColor 0.08 0.08 0.09 specularColor 0.16 0.16 0.18 shininess 0.25 } }
DEF METAL Appearance { material Material { diffuseColor 0.70 0.72 0.74 specularColor 0.90 0.90 0.90 shininess 0.80 } }
DEF NUT Appearance { material Material { diffuseColor 0.52 0.52 0.54 specularColor 0.78 0.78 0.80 shininess 0.45 } }

Group {
  children [
    # Project convention: 1 unit = 2.54 mm.
    # Mapped to SW1 footprint local coords so it matches the board slot and screw holes.

    # Main panel body: exact rectangular slot-fit (no overhang).
    Transform {
      translation 1.043 1.437 -0.670
      children [ Shape { appearance USE BODY geometry Box { size 1.181 2.756 1.100 } } ]
    }

    # Slider/toggle paddle centered in the slot and kept inside the opening.
    Transform {
      translation 1.043 1.437 0.276
      children [ Shape { appearance USE METAL geometry Box { size 1.772 0.787 0.550 } } ]
    }

    # Screw shafts through the 2 mm mounting holes.
    Transform {
      translation 3.976 1.437 -0.590
      rotation 1 0 0 1.570796
      children [ Shape { appearance USE METAL geometry Cylinder { radius 0.360 height 2.200 } } ]
    }
    Transform {
      translation -1.890 1.437 -0.590
      rotation 1 0 0 1.570796
      children [ Shape { appearance USE METAL geometry Cylinder { radius 0.360 height 2.200 } } ]
    }

    # Front-side screw heads / nuts.
    Transform {
      translation 3.976 1.437 0.177
      rotation 1 0 0 1.570796
      children [ Shape { appearance USE NUT geometry Cylinder { radius 0.520 height 0.260 } } ]
    }
    Transform {
      translation -1.890 1.437 0.177
      rotation 1 0 0 1.570796
      children [ Shape { appearance USE NUT geometry Cylinder { radius 0.520 height 0.260 } } ]
    }

    # Back-side nuts.
    Transform {
      translation 3.976 1.437 -1.358
      rotation 1 0 0 1.570796
      children [ Shape { appearance USE NUT geometry Cylinder { radius 0.520 height 0.260 } } ]
    }
    Transform {
      translation -1.890 1.437 -1.358
      rotation 1 0 0 1.570796
      children [ Shape { appearance USE NUT geometry Cylinder { radius 0.520 height 0.260 } } ]
    }
  ]
}
