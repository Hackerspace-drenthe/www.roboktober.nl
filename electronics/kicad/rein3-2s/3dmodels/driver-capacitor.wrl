#VRML V2.0 utf8

DEF BODY Appearance { material Material { diffuseColor 0.035 0.045 0.055 specularColor 0.18 0.2 0.22 shininess 0.3 } }
DEF STRIPE Appearance { material Material { diffuseColor 0.62 0.64 0.6 specularColor 0.3 0.3 0.3 shininess 0.25 } }
DEF METAL Appearance { material Material { diffuseColor 0.68 0.7 0.7 specularColor 0.85 0.85 0.85 shininess 0.75 } }

Group {
  children [
    # Thin leads centered on the two drill holes (0,0) and (4,0).
    Transform { translation 0.0 0.0 -0.65 children [ Shape { appearance USE METAL geometry Box { size 0.16 0.16 3.2 } } ] }
    Transform { translation 4.0 0.0 -0.65 children [ Shape { appearance USE METAL geometry Box { size 0.16 0.16 3.2 } } ] }

    # Wider standing can so both hole-centered leads sit naturally near the body.
    Transform { translation 2.0 0.0 2.3 children [ Shape { appearance USE BODY geometry Box { size 2.5 2.5 4.2 } } ] }
    Transform { translation 3.3 0.0 2.3 children [ Shape { appearance USE BODY geometry Box { size 0.42 2.5 4.2 } } ] }
    Transform { translation 0.7 0.0 2.3 children [ Shape { appearance USE BODY geometry Box { size 0.42 2.5 4.2 } } ] }
    Transform { translation 2.0 1.3 2.3 children [ Shape { appearance USE BODY geometry Box { size 2.5 0.42 4.2 } } ] }
    Transform { translation 2.0 -1.3 2.3 children [ Shape { appearance USE BODY geometry Box { size 2.5 0.42 4.2 } } ] }

    Transform { translation 2.92 0.92 2.3 children [ Shape { appearance USE BODY geometry Box { size 0.42 0.42 4.2 } } ] }
    Transform { translation 2.92 -0.92 2.3 children [ Shape { appearance USE BODY geometry Box { size 0.42 0.42 4.2 } } ] }
    Transform { translation 1.08 0.92 2.3 children [ Shape { appearance USE BODY geometry Box { size 0.42 0.42 4.2 } } ] }
    Transform { translation 1.08 -0.92 2.3 children [ Shape { appearance USE BODY geometry Box { size 0.42 0.42 4.2 } } ] }

    Transform { translation 3.42 0.0 2.3 children [ Shape { appearance USE STRIPE geometry Box { size 0.14 1.2 3.9 } } ] }
    Transform { translation 2.0 0.0 4.45 children [ Shape { appearance USE METAL geometry Box { size 2.7 2.7 0.14 } } ] }
  ]
}