#VRML V2.0 utf8

DEF BODY Appearance { material Material { diffuseColor 0.035 0.045 0.055 specularColor 0.18 0.2 0.22 shininess 0.3 } }
DEF STRIPE Appearance { material Material { diffuseColor 0.62 0.64 0.6 specularColor 0.3 0.3 0.3 shininess 0.25 } }
DEF METAL Appearance { material Material { diffuseColor 0.68 0.7 0.7 specularColor 0.85 0.85 0.85 shininess 0.75 } }

Group {
  children [
    # Real PCB hole centers are at x=0 and x=4 mm, so the two leads must sit exactly on those positions.
    Transform { translation 0.0 0.0 -0.10 children [ Shape { appearance USE METAL geometry Box { size 0.18 0.18 2.4 } } ] }
    Transform { translation 4.0 0.0 -0.10 children [ Shape { appearance USE METAL geometry Box { size 0.18 0.18 2.4 } } ] }

    # Compact radial body centered between the two true hole centers.
    Transform { translation 2.0 0.0 1.15 children [ Shape { appearance USE BODY geometry Box { size 2.0 2.0 2.5 } } ] }
    Transform { translation 3.0 0.0 1.15 children [ Shape { appearance USE STRIPE geometry Box { size 0.12 0.8 2.2 } } ] }
    Transform { translation 2.0 0.0 2.55 children [ Shape { appearance USE METAL geometry Box { size 1.5 1.5 0.10 } } ] }
  ]
}