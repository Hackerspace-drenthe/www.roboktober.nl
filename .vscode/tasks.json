		{
			"label": "SSH productie",
			"type": "shell",
			"command": "ssh",
			"args": [
				"-o",
				"ControlMaster=auto",
				"-o",
				"ControlPath=/home/rein/.ssh/roboktober-deploy-%C",
				"-o",
				"ControlPersist=15m",
				"rein@192.168.1.10"
			],
			"isBackground": false,
			"problemMatcher": []
		},
